    "제목 또는 주소": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Title or address"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトルまたはアドレス"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목 또는 주소"
          }
        }
      }
    },
    "주소 입력 또는 검색": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search or enter address"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索またはアドレスを入力"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주소 입력 또는 검색"
          }
        }
      }
    },
    "주소창에 주소를 입력하세요.\n열린 사이트 밖으로의 이동 · 팝업 · 외부 앱 호출은 자동으로 차단됩니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter an address above.\nNavigation away from the open site, pop-ups, and external app launches are blocked automatically."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アドレスバーにアドレスを入力してください。\n開いたサイトの外への移動・ポップアップ・外部アプリの起動は自動でブロックされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주소창에 주소를 입력하세요.\n열린 사이트 밖으로의 이동 · 팝업 · 외부 앱 호출은 자동으로 차단됩니다."
          }
        }
      }
    },
    "주소창의 별 버튼으로 추가합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add one with the star button in the address bar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アドレスバーの星ボタンで追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주소창의 별 버튼으로 추가합니다."
          }
        }
      }
    },

    },
    "차단 기록 (%lld)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocked (%lld)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブロック履歴（%lld）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차단 기록 (%lld)"
          }
        }
      }
    },
    "차단 기록 없음": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing Blocked"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブロック履歴なし"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차단 기록 없음"
          }
        }
      }
    },
    "차단 기록 지우기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear Blocked Log"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブロック履歴を消去"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차단 기록 지우기"
          }
        }
      }
    },
    "차단된 이동을 허용하거나, 방패 메뉴에서 사이트별 설정을 바꾸면 여기에 저장됩니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rules are saved here when you allow a blocked navigation or change per-site settings in the shield menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブロックされた移動を許可するか、盾メニューでサイト別の設定を変えると、ここに保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차단된 이동을 허용하거나, 방패 메뉴에서 사이트별 설정을 바꾸면 여기에 저장됩니다."
          }
        }
      }
    },
    "최근 30일 · 차단 횟수 순 (총 %lld건)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last 30 days · by count (%lld total)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直近30日 · 回数順（計%lld件）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 30일 · 차단 횟수 순 (총 %lld건)"
          }
        }
      }
    },

    "팝업": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pop-up"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポップアップ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팝업"
          }
        }
      }
    },
    "팝업과 외부 앱 호출은 항상 차단됩니다. 스크립트 설정은 페이지를 다시 불러오면 적용됩니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pop-ups and external app launches are always blocked. Script settings take effect after reloading the page."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポップアップと外部アプリの起動は常にブロックされます。スクリプトの設定はページを再読み込みすると反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
